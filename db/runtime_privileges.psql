-- Optional, operator-run PostgreSQL 16+ runtime grants.
-- NOT a schema migration. Provision the unprivileged LOGIN role separately.
-- Run using psql as the owner/migrator on the intended database:
--   psql "$AGENTMARGIN_ADMIN_DATABASE_URL" -v ON_ERROR_STOP=1 \
--     -v runtime_role=agentmargin_runtime -f db/runtime_privileges.psql
-- Do not grant this role ownership, BYPASSRLS, CREATEDB, CREATEROLE, or membership
-- in an elevated role. Review inherited and PUBLIC privileges separately.
BEGIN;
SELECT set_config('agentmargin.runtime_role', :'runtime_role', true);
REVOKE ALL ON SCHEMA public FROM :"runtime_role";
GRANT USAGE ON SCHEMA public TO :"runtime_role";
REVOKE ALL ON TABLE
  workspaces, workspace_api_keys, customers, usage_events, revenue_records,
  price_versions, workspace_price_versions FROM :"runtime_role";
GRANT SELECT ON TABLE
  customers, usage_events, revenue_records,
  price_versions, workspace_price_versions TO :"runtime_role";
GRANT INSERT ON TABLE
  customers, usage_events, revenue_records, workspace_price_versions TO :"runtime_role";
REVOKE ALL ON TABLE revenue_deliveries FROM :"runtime_role";
GRANT SELECT, INSERT ON TABLE revenue_deliveries TO :"runtime_role";
GRANT UPDATE(state,attempts,available_at,delivered_at,error_class) ON revenue_deliveries TO :"runtime_role";
REVOKE ALL ON ALL SEQUENCES IN SCHEMA public FROM :"runtime_role";
REVOKE ALL ON TABLE workspace_api_keys, workspaces FROM PUBLIC;
GRANT USAGE ON SCHEMA agentmargin_auth TO :"runtime_role";
GRANT EXECUTE ON FUNCTION agentmargin_auth.principal(text),
  agentmargin_auth.workspace(text), agentmargin_auth.event_digest(uuid,text,text) TO :"runtime_role";
-- Reject unsafe effective authority rather than silently claiming isolation.
DO $guard$
DECLARE
  runtime pg_roles%ROWTYPE;
BEGIN
  SELECT * INTO STRICT runtime FROM pg_roles WHERE rolname=current_setting('agentmargin.runtime_role');
  IF NOT runtime.rolcanlogin OR runtime.rolsuper OR runtime.rolbypassrls
     OR runtime.rolcreatedb OR runtime.rolcreaterole OR runtime.rolreplication
     OR runtime.rolinherit
     OR EXISTS (SELECT 1 FROM pg_auth_members WHERE member=runtime.oid)
     OR EXISTS (SELECT 1 FROM pg_database WHERE oid=(SELECT oid FROM pg_database WHERE datname=current_database()) AND datdba=runtime.oid)
     OR EXISTS (SELECT 1 FROM pg_class WHERE relnamespace='public'::regnamespace AND relowner=runtime.oid)
     OR EXISTS (SELECT 1 FROM pg_namespace WHERE nspname IN ('public','agentmargin_auth') AND nspowner=runtime.oid)
     OR EXISTS (SELECT 1 FROM pg_proc WHERE pronamespace IN ('public'::regnamespace,'agentmargin_auth'::regnamespace) AND proowner=runtime.oid)
     OR has_schema_privilege(runtime.oid,'public','CREATE')
     OR has_schema_privilege(runtime.oid,'agentmargin_auth','CREATE')
     OR has_database_privilege(runtime.oid,current_database(),'CREATE') THEN
    RAISE EXCEPTION 'Unsafe runtime role: require dedicated non-owner LOGIN NOINHERIT without memberships, elevated attributes or schema/database creation';
  END IF;
  IF has_any_column_privilege(runtime.oid,'public.workspace_api_keys','SELECT,INSERT,UPDATE,REFERENCES')
     OR has_table_privilege(runtime.oid,'public.workspace_api_keys','DELETE,TRUNCATE,TRIGGER')
     OR has_any_column_privilege(runtime.oid,'public.workspaces','SELECT,INSERT,UPDATE,REFERENCES')
     OR has_table_privilege(runtime.oid,'public.workspaces','DELETE,TRUNCATE,TRIGGER')
     OR EXISTS (
       SELECT 1 FROM pg_class WHERE oid IN ('public.customers'::regclass,'public.usage_events'::regclass,
         'public.revenue_records'::regclass,'public.workspace_price_versions'::regclass,'public.price_versions'::regclass)
       AND (has_table_privilege(runtime.oid,oid,'UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER')
         OR has_any_column_privilege(runtime.oid,oid,'UPDATE,REFERENCES'))
     ) OR has_any_column_privilege(runtime.oid,'public.price_versions','INSERT') THEN
    RAISE EXCEPTION 'Unsafe runtime grants: effective PUBLIC or column privileges exceed the supported runtime boundary';
  END IF;
  IF has_table_privilege(runtime.oid,'public.revenue_deliveries','DELETE,TRUNCATE,REFERENCES,TRIGGER')
    OR EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid='public.revenue_deliveries'::regclass
      AND attnum>0 AND NOT attisdropped AND attname NOT IN ('state','attempts','available_at','delivered_at','error_class')
      AND has_column_privilege(runtime.oid,attrelid,attnum,'UPDATE')) THEN
    RAISE EXCEPTION 'Unsafe runtime grants: durable delivery payload must remain immutable';
  END IF;
END;
$guard$;
COMMIT;
