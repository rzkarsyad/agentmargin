-- Operator-run ONLY on an isolated restored database, before runtime provision.
-- Default recovery policy: invalidate ALL restored bearer credentials. No stale
-- backup can assert that a credential is still safe. Issue new keys only after
-- independently reviewed cutover. No financial row or original digest is changed.
BEGIN;
SELECT set_config('agentmargin.restore_database', :'restore_database',true);
SELECT set_config('agentmargin.restore_confirmation', :'restore_confirmation',true);
DO $guard$ BEGIN
 IF current_database()<>current_setting('agentmargin.restore_database')
   OR current_setting('agentmargin.restore_confirmation')<>'invalidate-all-restored-keys' THEN
   RAISE EXCEPTION 'Explicit isolated-restore quarantine confirmation required';
 END IF;
END $guard$;
UPDATE public.workspace_api_keys SET revoked_at=coalesce(revoked_at,statement_timestamp());
DO $guard$ BEGIN
 IF EXISTS(SELECT 1 FROM public.workspace_api_keys WHERE revoked_at IS NULL) THEN
   RAISE EXCEPTION 'Restored credential quarantine failed';
 END IF;
END $guard$;
COMMIT;
